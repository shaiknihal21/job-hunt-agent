# Groq (free tier) — used for job ranking and resume tailoring
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Database lives under backend/data/ (absolute path resolved by config.py)
DATABASE_URL=sqlite:///./backend/data/jobhunt.db
MIN_MATCH_SCORE=55

# Auto-apply: jobs scoring above threshold get tailored + submitted
# AUTO_APPLY_SOURCES=*  → all sources (Naukri=full auto; LinkedIn/careers=browser assist)
# MIN_SALARY_LPA=0 disables salary filtering
MIN_SALARY_LPA=0
AUTO_APPLY_MIN_SCORE=60
AUTO_APPLY_MIN_ATS_SCORE=60
AUTO_APPLY_ENABLED=true
AUTO_APPLY_SOURCES=*
NAUKRI_APPLY_MODE=assisted
ASSISTED_APPLY_WAIT_SEC=180
FILTER_EXCLUDED_COMPANIES=false

CANDIDATE_YEARS_EXPERIENCE=1
MAX_DAILY_APPLICATIONS=5
PLAYWRIGHT_HEADLESS=false

# Auto-apply runs every N hours when uvicorn scheduler is running (24 = once daily)
SCAN_INTERVAL_HOURS=24

# Discovery sources
INCLUDE_LINKEDIN=true
INCLUDE_FOUNDIT=true
INCLUDE_FAANG_CAREERS=true
DISCOVERY_SOURCE_TIMEOUT_SEC=300
SCRAPER_MIN_DELAY_MS=800
LLM_RANK_TOP_N=20
NAUKRI_ENRICH_MAX=40

# Optional Telegram alerts (bot token + your chat id)
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
